# ==============================================================================
# Dynamic Railway ETA Prediction Platform - Environment Configuration
# Copy this file to .env and adjust variables as required.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Environment Mode: 'development' | 'production' | 'staging'
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
PROJECT_NAME="Dynamic Railway ETA Prediction Platform"
VERSION=1.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80

# Data Provider: 'simulation' | 'railradar' | 'third_party' | 'cris_ntes'
DATA_PROVIDER=simulation

# Rail Radar Live Train API Configuration (for live pan-India feeds)
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Primary Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./data/railway_eta.db
# Containerized PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://railway_user:railway_secure_pass@postgres:5432/railway_eta_db

# PostgreSQL Credentials (for docker-compose)
POSTGRES_USER=railway_user
POSTGRES_PASSWORD=railway_secure_pass
POSTGRES_DB=railway_eta_db
POSTGRES_PORT=5432

# Redis Cache Service
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Environmental Meteorological API (Open-Meteo)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
